# CurseForge packaging rules
# Retained for repository-packager compatibility. The canonical release flow
# uploads the verified staged archive manually after stable approval.

# Ignore all non-addon directories and repository metadata
ignore:
  - .agent
  - .git
  - .gitattributes
  - .github
  - .gitignore
  - .rules
  - .tools
  - .versions
  - .vscode
  - Images
  - CHANGELOG.md
  - CONTROLS.md
  - CURSEFORGE_DESCRIPTION.md
  - DEAD_ENDS.md
  - README.md
  - BETA_TEST_CHECKLIST.md
  - package.json
  - package-lock.json
  - RELEASE_NOTES.md
  - TECHNICAL_CHANGES.md
  - TEMP_NOTES.md
